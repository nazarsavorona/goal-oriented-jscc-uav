# semvideo environment variables
# Copy this file to .env and fill in your values

# Weights & Biases
WANDB_PROJECT=semvideo
WANDB_ENTITY=your-wandb-username
WANDB_API_KEY=your-api-key

# CUDA Configuration (RTX 3060 = compute capability 8.6)
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST=8.6

# Data paths
SEMVIDEO_DATA_DIR=./data
SEMVIDEO_EXPERIMENTS_DIR=./experiments

# Reproducibility
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=42
